<view class="screen replay-screen">
  <view class="header"><button class="secondary" bindtap="back">{{match ? '对局列表' : '返回'}}</button><text class="title">{{match ? '牌谱回放' : '我的牌谱'}}</text><text wx:if="{{match}}" class="pill">{{report.status === 'passed' ? '验证通过' : report.status === 'unverified' ? '尚未完整验证' : '验证未通过'}}</text><button wx:if="{{!match}}" class="secondary" bindtap="calculator">计算器／导入</button></view>
  <block wx:if="{{!match}}"><view class="row retention"><text class="muted">每位玩家保留的对局数</text><input type="number" value="{{limit}}" bindinput="limitInput" aria-label="牌谱保存场数" /><button class="secondary" bindtap="saveLimit">保存设置</button></view><scroll-view class="history-list" scroll-y><view wx:for="{{matches}}" wx:key="id" class="card history-item" data-id="{{item.id}}" bindtap="openEvent" aria-role="button"><view class="row"><text class="grow">{{item.date}} · {{item.hands}} / {{item.handsPerMatch}} 局</text><text>{{item.score}} 分</text></view><text class="muted" wx:for="{{item.seats}}" wx:for-item="player" wx:key="playerId">{{player.name}} · </text></view><text wx:if="{{!matches.length}}" class="muted">已完成的对局会显示在这里。正在进行的对局，可从牌桌查看已结束小局的牌谱。</text></scroll-view></block>
  <block wx:else><view class="row replay-controls"><picker range="{{handNames}}" value="{{handIndex}}" bindchange="handChange"><button class="secondary">{{handNames[handIndex]}} ▾</button></picker><button class="secondary" data-delta="-1" bindtap="step" disabled="{{eventIndex === 0}}">上一步</button><button class="primary" bindtap="play">{{playing ? '暂停' : '播放'}}</button><button class="secondary" data-delta="1" bindtap="step" disabled="{{eventIndex === eventCount}}">下一步</button><picker range="{{playerNames}}" value="{{perspective}}" bindchange="perspective"><button class="secondary">{{playerNames[perspective]}} ▾</button></picker><view class="row"><switch checked="{{revealAll}}" bindchange="reveal" color="#b99b48" /><text class="muted">显示全部手牌</text></view></view><view class="row"><slider class="grow timeline" min="0" max="{{eventCount}}" value="{{eventIndex}}" bindchange="seek" activeColor="#f2cd70" /><text class="event-label">{{eventIndex}} / {{eventCount}} · {{eventLabel}}</text></view><scroll-view scroll-y class="replay-board"><view class="player-grid"><view wx:for="{{vm.players}}" wx:key="seat" class="replay-player card"><view class="row"><text class="grow">{{item.dealer ? '庄 · ' : ''}}{{item.name}} {{item.acting ? ' · 轮到出牌' : ''}}</text><text>{{item.score}} 分 分 · 已飘 {{item.floats}} 张</text></view><view class="replay-tiles"><view wx:for="{{item.hand}}" wx:for-item="face" wx:key="key" class="replay-hand-slot {{face.last ? 'latest' : ''}}"><mahjong-tile tile-id="{{face.id}}" wildcard="{{match.hands[handIndex].wildcardType}}" small="{{true}}" disabled="{{true}}" /></view><view wx:for="{{item.melds}}" wx:for-item="meld" wx:key="key" class="replay-meld"><mahjong-tile wx:for="{{meld.tiles}}" wx:for-item="face" wx:key="key" tile-id="{{face.id}}" small="{{true}}" disabled="{{true}}" /></view></view><view class="replay-discards"><text class="muted">弃牌</text><view class="replay-pond"><view wx:for="{{item.discards}}" wx:for-item="face" wx:key="key" class="replay-discard {{face.claimed ? 'faded' : ''}}"><mahjong-tile tile-id="{{face.id}}" small="{{true}}" disabled="{{true}}" /></view></view><view wx:if="{{item.floated.length}}" class="replay-floated"><text class="muted">已飘癞子</text><mahjong-tile wx:for="{{item.floated}}" wx:for-item="face" wx:key="key" tile-id="{{face.id}}" small="{{true}}" disabled="{{true}}" /></view></view></view></view><text class="muted">{{vm.status}} · {{vm.indicator.name}} 朝天 · {{vm.wildcard.name}} 癞子 · {{match.hands[handIndex].head <= match.hands[handIndex].tail ? '已记录牌墙头尾摸牌' : '牌墙已摸完'}}</text><text wx:if="{{vm.result}}">{{vm.result.label}}</text></scroll-view><view class="row replay-footer"><button class="secondary" bindtap="verify">验证本局</button><button class="secondary" bindtap="export">导出已完成牌谱</button><text class="muted">回放进度由本地事件重建。</text></view></block>
  <text wx:if="{{error}}" class="error">{{error}}</text>
</view>
